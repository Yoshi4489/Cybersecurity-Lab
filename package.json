{
  "name": "recon-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1 --port 5173",
    "build": "vinext build",
    "start": "vinext start --hostname 127.0.0.1 --port 5173",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "doctor": "node scripts/doctor.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "labs:prepare": "node scripts/prepare-instances.mjs",
    "lab": "node scripts/labctl.mjs start",
    "lab:stop": "node scripts/labctl.mjs stop",
    "lab:status": "node scripts/labctl.mjs status",
    "lab:controller": "node controller/server.mjs",
    "labs:list": "node scripts/standalone-labctl.mjs list",
    "labs:start": "node scripts/standalone-labctl.mjs start",
    "labs:stop": "node scripts/standalone-labctl.mjs stop",
    "labs:reset": "node scripts/standalone-labctl.mjs reset",
    "labs:status": "node scripts/standalone-labctl.mjs status",
    "labs:smoke": "node scripts/standalone-labctl.mjs smoke",
    "labs:shell": "node scripts/standalone-labctl.mjs shell",
    "labs:verify": "node scripts/standalone-labctl.mjs verify"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "js-yaml": "^4.3.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2"
  },
  "type": "module"
}
